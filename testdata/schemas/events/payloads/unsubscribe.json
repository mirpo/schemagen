{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UnsubscribePayload",
  "description": "Payload for unsubscribe event",
  "type": "object",
  "properties": {
    "subscriptionId": {
      "type": "string",
      "format": "uuid",
      "description": "ID of subscription to cancel"
    },
    "reason": {
      "type": "string",
      "description": "Reason for unsubscribing"
    }
  },
  "required": ["subscriptionId"]
}
